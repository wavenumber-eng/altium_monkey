        "designator": {
          "type": "string"
        },
        "channel_name": {
          "type": "string"
        },
        "channel_index": {
          "$ref": "#/$defs/NetlistB0NullableChannelIndex"
        },
        "repeat_value": {
          "$ref": "#/$defs/NullableInt64"
        }
