        },
        "pin": {
          "$ref": "#/$defs/SchematicIdentityString"
        },
        "pin_name": {
          "type": "string"
        },
        "pin_type": {
          "$ref": "#/$defs/NetlistB0PinType"
        }
      },
      "required": [
        "component_id",
        "designator",
        "pin",
        "pin_name",
        "pin_type"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "NetlistB0Graphical": {
      "type": "object",
      "properties": {
        "wires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "junctions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "power_ports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sheet_entries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetlistB0GraphicalPin"
          }
        }
      },
      "required": [
        "wires",
        "junctions",
        "labels",
        "power_ports",
        "ports",
        "sheet_entries",
        "pins"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "NetlistB0Endpoint": {
      "type": "object",
      "properties": {
        "endpoint_id": {
          "$ref": "#/$defs/SchematicIdentityString"
        },
        "role": {
          "$ref": "#/$defs/SchematicIdentityString"
        },
        "element_id": {
          "type": "string"
        },
        "object_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source_page": {
          "$ref": "#/$defs/NetlistB0NullableSourcePage"
        },
        "component_id": {
          "$ref": "#/$defs/NullableString"
        },
        "designator": {
          "$ref": "#/$defs/NullableString"
        },
        "pin": {
          "$ref": "#/$defs/NullableString"
        },
        "pin_name": {
          "$ref": "#/$defs/NullableString"
        },
        "pin_type": {
          "$ref": "#/$defs/NetlistB0NullablePinType"
        },
        "connection_point": {
          "$ref": "#/$defs/NetlistB0NullableConnectionPoint"
        }
      },
      "required": [
        "endpoint_id",
        "role",
        "element_id",
        "object_id",
        "name",
        "source_page",
        "component_id",
        "designator",
        "pin",
        "pin_name",
        "pin_type",
        "connection_point"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "NetlistB0HierarchyLevel": {
      "type": "object",
      "properties": {
        "sheet_symbol_uid": {
          "$ref": "#/$defs/SchematicIdentityString"
        },
        "child_filename": {
          "$ref": "#/$defs/SchematicIdentityString"
