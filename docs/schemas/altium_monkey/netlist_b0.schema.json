{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:altium-monkey:schema:netlist_b0",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "altium_monkey.netlist.b0"
    },
    "generator": {
      "type": "string",
      "const": "altium_monkey"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetlistB0Component"
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetlistB0Net"
      }
    }
  },
  "required": [
    "schema",
    "generator",
    "components",
    "nets"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Current semantic netlist transport.",
  "title": "Altium Monkey netlist b0",
  "$defs": {
    "NetlistB0Component": {
      "type": "object",
      "properties": {
        "component_id": {
          "$ref": "#/$defs/SchematicIdentityString"
        },
        "designator": {
          "$ref": "#/$defs/SchematicIdentityString"
        },
        "logical_designator": {
          "$ref": "#/$defs/NullableString"
        },
        "physical_designator": {
          "$ref": "#/$defs/NullableString"
        },
        "source_page": {
          "$ref": "#/$defs/NetlistB0NullableSourcePage"
        },
        "value": {
          "type": "string"
        },
        "footprint": {
          "type": "string"
        },
        "library_ref": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/SchematicStringParameterMap"
        }
      },
      "required": [
        "component_id",
        "designator",
        "logical_designator",
        "physical_designator",
        "source_page",
        "value",
        "footprint",
        "library_ref",
        "description",
        "parameters"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "NetlistB0Net": {
      "type": "object",
      "properties": {
        "uid": {
          "$ref": "#/$defs/SchematicIdentityString"
        },
        "name": {
          "type": "string"
        },
        "auto_named": {
          "type": "boolean"
        },
        "source_pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SchematicSourcePage"
          }
        },
        "terminals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetlistB0Terminal"
          }
        },
        "graphical": {
          "$ref": "#/$defs/NetlistB0Graphical"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetlistB0Endpoint"
          }
        },
        "hierarchy_paths": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/NetlistB0HierarchyLevel"
            }
          }
        }
      },
      "required": [
        "uid",
        "name",
        "auto_named",
        "source_pages",
        "terminals",
        "graphical",
        "aliases",
        "endpoints",
        "hierarchy_paths"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "SchematicIdentityString": {
      "type": "string",
      "minLength": 1,
      "description": "Non-empty identity used by current schematic transport contracts."
    },
    "NullableString": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required field whose value may be a string or JSON null."
    },
    "NetlistB0NullableSourcePage": {
      "anyOf": [
        {
          "$ref": "#/$defs/SchematicSourcePage"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required source page whose value may be JSON null."
    },
    "SchematicStringParameterMap": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {
        "type": "string"
      },
      "description": "String-only component parameters for current schematic transports."
    },
    "SchematicSourcePage": {
      "type": "object",
      "properties": {
        "physical_document_id": {
          "$ref": "#/$defs/NullableString"
