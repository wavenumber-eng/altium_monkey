      "required": [
        "sheet_symbol_uid",
        "child_filename",
        "designator",
        "channel_name",
        "channel_index",
        "repeat_value"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "NetlistB0PinType": {
      "anyOf": [
        {
          "type": "string",
          "const": "INPUT"
        },
        {
          "type": "string",
          "const": "IO"
        },
        {
          "type": "string",
          "const": "OUTPUT"
        },
        {
          "type": "string",
          "const": "OPEN_COLLECTOR"
        },
        {
          "type": "string",
          "const": "PASSIVE"
        },
        {
          "type": "string",
          "const": "TRISTATE"
        },
        {
          "type": "string",
          "const": "OPEN_EMITTER"
        },
        {
          "type": "string",
          "const": "POWER"
        },
        {
          "type": "string",
          "const": "UNKNOWN"
        }
      ],
      "description": "Closed electrical pin-type inventory retained by the rich model."
    },
    "NetlistB0GraphicalPin": {
      "type": "object",
      "properties": {
        "component_id": {
          "$ref": "#/$defs/SchematicIdentityString"
        },
        "designator": {
          "$ref": "#/$defs/SchematicIdentityString"
        },
        "pin": {
          "$ref": "#/$defs/SchematicIdentityString"
        },
        "svg_id": {
          "$ref": "#/$defs/SchematicIdentityString"
        }
      },
      "required": [
        "component_id",
        "designator",
        "pin",
        "svg_id"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "NetlistB0NullablePinType": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetlistB0PinType"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required endpoint pin type whose value may be JSON null."
    },
    "NetlistB0NullableConnectionPoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetlistB0ConnectionPoint"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required connection point whose value may be JSON null."
    },
    "NetlistB0NullableChannelIndex": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetlistB0NonNegativeInt64"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required non-negative channel index whose value may be JSON null."
    },
    "NullableInt64": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignedInt64"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required field whose value may be a signed integer or JSON null."
    },
    "NetlistB0ConnectionPoint": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/SignedInt64"
        },
        "y": {
          "$ref": "#/$defs/SignedInt64"
        },
        "units": {
          "type": "string",
          "const": "altium_coord"
        }
      },
      "required": [
        "x",
        "y",
        "units"
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "NetlistB0NonNegativeInt64": {
      "type": "integer",
      "description": "Signed 64-bit JSON integer shared by schema and Rust boundaries.",
      "x-altium-monkey-signed-integer-width": 64,
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "SignedInt64": {
      "type": "integer",
      "description": "Signed 64-bit JSON integer shared by schema and Rust boundaries.",
      "x-altium-monkey-signed-integer-width": 64,
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    }
  }
}
