      "const": "altium_monkey.design.b0"
    },
    "generator": {
      "const": "altium_monkey"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "options": {
      "$ref": "#/$defs/options"
    },
    "sheets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sheet"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/design_component"
      }
    },
    "schematic_hierarchy": {
      "$ref": "#/$defs/schematic_hierarchy"
    },
    "pnp": {
      "$ref": "#/$defs/pnp"
    },
    "compile": {
      "$ref": "#/$defs/compile"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/design_net"
      }
    },
    "indexes": {
      "$ref": "#/$defs/indexes"
    },
    "compiled_schematic_graph": {
      "$ref": "#/$defs/compiled_schematic_graph"
    },
    "physical_page_metadata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/physical_page_metadata"
      }
    }
  },
  "$defs": {
    "string_or_null": {
      "type": [
        "string",
        "null"
      ]
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "string_list_map": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/string_list"
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sheet_number"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "sheet_number": {
          "type": [
            "integer",
            "string"
          ],
          "description": "Canonical decimal sheet numbers are emitted as integers for compatibility; non-canonical Altium SheetNumber parameter values are emitted as exact strings."
        }
      }
    },
    "parameter_map": {
      "type": "object",
      "additionalProperties": true
    },
    "variant_key_values": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dnp"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "dnp": {
          "$ref": "#/$defs/string_list"
        },
        "variations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant_key_values"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant_key_values"
          }
        },
        "param_variations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant_key_values"
          }
        },
        "parameter_overrides": {
