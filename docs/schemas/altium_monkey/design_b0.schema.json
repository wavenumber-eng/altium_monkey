        "name": {
          "type": "string"
        },
        "auto_named": {
          "type": "boolean"
        },
        "source_sheets": {
          "$ref": "#/$defs/string_list"
        },
        "terminals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/terminal"
          }
        },
        "graphical": {
          "$ref": "#/$defs/freeform_object"
        },
        "aliases": {
          "$ref": "#/$defs/string_list"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "hierarchy_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/net_hierarchy_path"
          }
        },
        "name_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name_source"
          }
        }
      }
    },
    "name_source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "role",
        "source"
