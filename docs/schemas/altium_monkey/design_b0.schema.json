{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:altium-monkey:schema:design_b0",
  "title": "Altium Monkey design b0",
  "description": "Full Altium design analysis emitted by AltiumDesign.to_json().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generator",
    "project",
    "variants",
    "options",
    "sheets",
    "components",
    "schematic_hierarchy",
    "nets",
    "compiled_schematic_graph",
    "physical_page_metadata"
  ],
