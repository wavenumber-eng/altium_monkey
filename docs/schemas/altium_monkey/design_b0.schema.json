        "source_pcbdoc": {
          "type": "string"
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pnp_placement"
          }
        }
      }
    },
    "compile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schema": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/freeform_object"
        },
        "options": {
          "$ref": "#/$defs/freeform_object"
        },
        "annotation": {
          "$ref": "#/$defs/freeform_object"
        },
        "stats": {
