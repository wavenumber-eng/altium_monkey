          "additionalProperties": {
            "$ref": "#/$defs/parameter_map"
          }
        },
        "is_current": {
          "type": "boolean"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "filename",
        "parameters"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/string_or_null"
        },
        "filename": {
          "$ref": "#/$defs/string_or_null"
        },
        "parameters": {
          "$ref": "#/$defs/parameter_map"
        },
        "current_variant": {
          "$ref": "#/$defs/string_or_null"
        }
      }
    },
    "design_component": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "designator"
      ],
      "properties": {
        "designator": {
          "type": "string"
        },
        "svg_id": {
          "$ref": "#/$defs/string_or_null"
        },
        "value": {
          "type": "string"
        },
        "footprint": {
          "type": "string"
        },
        "library_ref": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hierarchy": {
          "$ref": "#/$defs/freeform_object"
        },
        "classification": {
          "$ref": "#/$defs/freeform_object"
        },
        "parameters": {
          "$ref": "#/$defs/parameter_map"
        },
        "compiled_component_id": {
          "type": "string"
        },
        "physical_document_id": {
          "type": "string"
        },
        "physical_page_id": {
          "type": "string"
        },
        "source_unique_id": {
          "$ref": "#/$defs/string_or_null"
        },
        "source_unique_id_path": {
          "$ref": "#/$defs/string_or_null"
        },
        "dnp": {
          "type": "boolean"
        },
        "fitted": {
          "type": "boolean"
        },
        "ambiguous_physical_designator": {
          "type": "boolean"
        }
      }
    },
    "pnp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "position_mode",
        "source_pcbdoc",
        "placements"
      ],
      "properties": {
        "units": {
          "const": "mm"
        },
        "position_mode": {
          "enum": [
            "altium-pick-place",
            "component-origin"
          ]
